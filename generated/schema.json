{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "Edition": {
      "$ref": "#/$defs/Edition"
    },
    "Headline": {
      "$ref": "#/$defs/Headline"
    },
    "ThreadMap": {
      "$ref": "#/$defs/ThreadMap"
    },
    "Story": {
      "$ref": "#/$defs/Story"
    },
    "Sidebar": {
      "$ref": "#/$defs/Sidebar"
    },
    "Colophon": {
      "$ref": "#/$defs/Colophon"
    },
    "Lede": {
      "$ref": "#/$defs/Lede"
    },
    "Section": {
      "$ref": "#/$defs/Section"
    },
    "Prose": {
      "$ref": "#/$defs/Prose"
    },
    "PullQuote": {
      "$ref": "#/$defs/PullQuote"
    },
    "Exchange": {
      "$ref": "#/$defs/Exchange"
    },
    "Positions": {
      "$ref": "#/$defs/Positions"
    },
    "LeadArt": {
      "$ref": "#/$defs/LeadArt"
    },
    "ArticleSummary": {
      "$ref": "#/$defs/ArticleSummary"
    },
    "ArticleQuote": {
      "$ref": "#/$defs/ArticleQuote"
    },
    "KeyPoints": {
      "$ref": "#/$defs/KeyPoints"
    },
    "OpenQuestions": {
      "$ref": "#/$defs/OpenQuestions"
    },
    "ReadingList": {
      "$ref": "#/$defs/ReadingList"
    },
    "FactBox": {
      "$ref": "#/$defs/FactBox"
    },
    "Timeline": {
      "$ref": "#/$defs/Timeline"
    },
    "Cast": {
      "$ref": "#/$defs/Cast"
    },
    "VoxPop": {
      "$ref": "#/$defs/VoxPop"
    },
    "Correction": {
      "$ref": "#/$defs/Correction"
    },
    "Quote": {
      "$ref": "#/$defs/Quote"
    },
    "Term": {
      "$ref": "#/$defs/Term"
    },
    "Side": {
      "$ref": "#/$defs/Side"
    },
    "Question": {
      "$ref": "#/$defs/Question"
    },
    "Resource": {
      "$ref": "#/$defs/Resource"
    },
    "ResourceGroup": {
      "$ref": "#/$defs/ResourceGroup"
    },
    "Fact": {
      "$ref": "#/$defs/Fact"
    },
    "Event": {
      "$ref": "#/$defs/Event"
    },
    "Person": {
      "$ref": "#/$defs/Person"
    }
  },
  "required": [
    "Edition",
    "Headline",
    "ThreadMap",
    "Story",
    "Sidebar",
    "Colophon",
    "Lede",
    "Section",
    "Prose",
    "PullQuote",
    "Exchange",
    "Positions",
    "LeadArt",
    "ArticleSummary",
    "ArticleQuote",
    "KeyPoints",
    "OpenQuestions",
    "ReadingList",
    "FactBox",
    "Timeline",
    "Cast",
    "VoxPop",
    "Correction",
    "Quote",
    "Term",
    "Side",
    "Question",
    "Resource",
    "ResourceGroup",
    "Fact",
    "Event",
    "Person"
  ],
  "additionalProperties": false,
  "$defs": {
    "Edition": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Headline"
              },
              {
                "$ref": "#/$defs/ThreadMap"
              },
              {
                "$ref": "#/$defs/Story"
              },
              {
                "$ref": "#/$defs/Sidebar"
              },
              {
                "$ref": "#/$defs/Colophon"
              }
            ]
          }
        }
      },
      "required": [
        "blocks"
      ],
      "additionalProperties": false,
      "description": "The whole page, in order: Headline, ThreadMap, Story, Sidebar, Colophon."
    },
    "Headline": {
      "type": "object",
      "properties": {
        "kicker": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "dek": {
          "type": "string"
        }
      },
      "required": [
        "kicker",
        "title",
        "dek"
      ],
      "additionalProperties": false,
      "description": "The banner: a short section label (kicker), an editor's headline about what the thread is really about, and a one-sentence summary (dek)."
    },
    "ThreadMap": {
      "type": "object",
      "properties": {
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "parent": {
                "type": "number"
              },
              "depth": {
                "type": "number"
              },
              "hours": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "parent",
              "depth",
              "hours"
            ],
            "additionalProperties": false
          }
        },
        "quoted": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "comments"
      ],
      "additionalProperties": false,
      "description": "The lead graphic: every comment plotted by time and reply depth. comments is the comments list from the get_comment_timeline Query. Comments quoted on the page are marked automatically; quoted is optional."
    },
    "Story": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/LeadArt"
              },
              {
                "$ref": "#/$defs/Lede"
              },
              {
                "$ref": "#/$defs/Section"
              },
              {
                "$ref": "#/$defs/PullQuote"
              },
              {
                "$ref": "#/$defs/FactBox"
              },
              {
                "$ref": "#/$defs/Positions"
              },
              {
                "$ref": "#/$defs/VoxPop"
              },
              {
                "$ref": "#/$defs/Correction"
              }
            ]
          }
        }
      },
      "required": [
        "blocks"
      ],
      "additionalProperties": false,
      "description": "The main story: an optional LeadArt, a Lede, then Sections. A PullQuote, FactBox, Positions, VoxPop or Correction placed between Sections breaks out across the full width of the story."
    },
    "LeadArt": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "credit": {
          "type": "string"
        }
      },
      "required": [
        "src",
        "caption",
        "credit"
      ],
      "additionalProperties": false,
      "description": "An image printed in black and white, like a newspaper photo. Use the image you are given; never invent a src. caption says what it shows in one sentence; credit names the source (e.g. \"Screenshot of example.com\")."
    },
    "Lede": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "cites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Quote"
          }
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "description": "The opening paragraph of the story, set large with a drop cap. 2 to 4 sentences. Like Prose, it may quote a commenter at {1}."
    },
    "Quote": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number"
        },
        "excerpt": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "description": "A comment from the thread, by id. excerpt must be copied character for character from that comment; omit it to quote the whole comment."
    },
    "Section": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Prose"
              },
              {
                "$ref": "#/$defs/PullQuote"
              },
              {
                "$ref": "#/$defs/Exchange"
              },
              {
                "$ref": "#/$defs/Positions"
              },
              {
                "$ref": "#/$defs/LeadArt"
              },
              {
                "$ref": "#/$defs/ArticleSummary"
              },
              {
                "$ref": "#/$defs/ArticleQuote"
              },
              {
                "$ref": "#/$defs/KeyPoints"
              },
              {
                "$ref": "#/$defs/OpenQuestions"
              },
              {
                "$ref": "#/$defs/ReadingList"
              },
              {
                "$ref": "#/$defs/FactBox"
              },
              {
                "$ref": "#/$defs/Timeline"
              },
              {
                "$ref": "#/$defs/Cast"
              },
              {
                "$ref": "#/$defs/VoxPop"
              },
              {
                "$ref": "#/$defs/Correction"
              }
            ]
          }
        }
      },
      "required": [
        "title",
        "blocks"
      ],
      "additionalProperties": false,
      "description": "A titled part of the story or sidebar. In the Story its text is set in two columns."
    },
    "Prose": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "cites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Quote"
          }
        },
        "terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Term"
          }
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "description": "A paragraph in the editor's voice: report and paraphrase, the way a newspaper does. Plain text, no markdown. To quote a commenter, write {1}, {2}… where their words go and list the Quotes in cites (each excerpt a short phrase or sentence); the page prints the excerpt in quotation marks with the commenter's name. Never type quoted words or quotation marks around someone's words yourself. Terms are marked inline and defined after the paragraph."
    },
    "Term": {
      "type": "object",
      "properties": {
        "term": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        }
      },
      "required": [
        "term",
        "definition"
      ],
      "additionalProperties": false,
      "description": "A word in a Prose text to define for the reader. term must appear exactly in the text. The definition is added context and is shown apart from the thread."
    },
    "PullQuote": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number"
        },
        "excerpt": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "description": "A large display quote of one comment. Use sparingly, at most one or two per edition, for a line that sums up a whole debate."
    },
    "Exchange": {
      "type": "object",
      "properties": {
        "quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Quote"
          }
        }
      },
      "required": [
        "quotes"
      ],
      "additionalProperties": false,
      "description": "A back-and-forth printed as a transcript. Use rarely: usually it reads better told in Prose with cites. Each quote must be a direct reply to the one before it, or nothing renders."
    },
    "Positions": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "sides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Side"
          }
        }
      },
      "required": [
        "question",
        "sides"
      ],
      "additionalProperties": false,
      "description": "Where the thread splits, as 2 or 3 sides with the comments behind each, shown in one row. More than 3 sides are folded into an \"Others\" side, so prefer 2 or 3. Shows how the cited comments divide; never declares a winner."
    },
    "Side": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Quote"
          }
        }
      },
      "required": [
        "label",
        "summary",
        "quotes"
      ],
      "additionalProperties": false,
      "description": "One side of a disagreement: a short label, a one-sentence summary, and the comments that argue it."
    },
    "ArticleSummary": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title",
        "points"
      ],
      "additionalProperties": false,
      "description": "What the linked article says, as short points, kept visibly apart from what commenters said."
    },
    "ArticleQuote": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "description": "A quote from the linked article. Must be copied exactly from the article, or nothing renders."
    },
    "KeyPoints": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title",
        "items"
      ],
      "additionalProperties": false,
      "description": "A numbered summary box: 3 to 5 one-sentence takeaways."
    },
    "OpenQuestions": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Question"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "description": "Questions the thread raised and didn't settle."
    },
    "Question": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "id": {
          "type": "number"
        }
      },
      "required": [
        "question",
        "id"
      ],
      "additionalProperties": false,
      "description": "A question the thread left unsettled, and the id of the comment that raised it."
    },
    "ReadingList": {
      "type": "object",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceGroup"
          }
        }
      },
      "required": [
        "groups"
      ],
      "additionalProperties": false,
      "description": "Links and tools from the thread, grouped. Credits who mentioned each one."
    },
    "ResourceGroup": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resource"
          }
        }
      },
      "required": [
        "title",
        "items"
      ],
      "additionalProperties": false,
      "description": "A titled group of resources."
    },
    "Resource": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "name",
        "note"
      ],
      "additionalProperties": false,
      "description": "Something worth following up. url must be a link that appears in the thread; for things named without a link, omit url and give the ids of the comments that mention it."
    },
    "FactBox": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          }
        }
      },
      "required": [
        "title",
        "facts"
      ],
      "additionalProperties": false,
      "description": "Large figures that carry the news (\"By the numbers\"), 2 to 4 Facts: real-world measurements, counts, prices or dates, each label clear on its own. Never details from inside a work of fiction."
    },
    "Fact": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "id": {
          "type": "number"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false,
      "description": "A figure and what it counts (\"2 PB\", \"of data in the warehouse\"). It must be stated in the article or a comment; give the comment id when it comes from the thread."
    },
    "Timeline": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          }
        }
      },
      "required": [
        "title",
        "events"
      ],
      "additionalProperties": false,
      "description": "A chronology of 3 to 7 Events, for incidents, histories and projects that changed over time."
    },
    "Event": {
      "type": "object",
      "properties": {
        "when": {
          "type": "string"
        },
        "what": {
          "type": "string"
        },
        "id": {
          "type": "number"
        }
      },
      "required": [
        "when",
        "what"
      ],
      "additionalProperties": false,
      "description": "One entry in a Timeline: when it happened (\"2021\", \"March\", \"9:14 a.m.\") and what happened, in one sentence. Give the comment id when the thread is the source."
    },
    "Cast": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "people": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Person"
          }
        }
      },
      "required": [
        "title",
        "people"
      ],
      "additionalProperties": false,
      "description": "The people the story is told through (\"Who's talking\"), 3 to 6 People, as named in the story."
    },
    "Person": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number"
        },
        "who": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "who"
      ],
      "additionalProperties": false,
      "description": "A commenter, by one of their comments (the page prints their username from it), and who they are in a short phrase from what they say about themselves."
    },
    "VoxPop": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Quote"
          }
        }
      },
      "required": [
        "title",
        "quotes"
      ],
      "additionalProperties": false,
      "description": "Readers answering one question in their own words, side by side. title is the question they were answering, phrased as a question (\"Why are people still on Ubuntu?\"). Two to four Quotes from different readers, each with an excerpt of one sentence that answers it."
    },
    "Correction": {
      "type": "object",
      "properties": {
        "claim": {
          "type": "string"
        },
        "quote": {
          "$ref": "#/$defs/Quote"
        }
      },
      "required": [
        "claim",
        "quote"
      ],
      "additionalProperties": false,
      "description": "\"For the record\": a statement of fact that turned out wrong, from the article or a commenter, in your words and without saying who corrected it (claim), and the correcting comment with its key sentence as excerpt (quote). Only when the thread really corrects a fact, not for disagreements."
    },
    "Sidebar": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/KeyPoints"
              },
              {
                "$ref": "#/$defs/Cast"
              },
              {
                "$ref": "#/$defs/FactBox"
              },
              {
                "$ref": "#/$defs/Timeline"
              },
              {
                "$ref": "#/$defs/Correction"
              },
              {
                "$ref": "#/$defs/Section"
              }
            ]
          }
        }
      },
      "required": [
        "blocks"
      ],
      "additionalProperties": false,
      "description": "The column beside the story: KeyPoints or a Cast first, then boxes and Sections for open questions and reading."
    },
    "Colophon": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "description": "The closing note on how the edition was made. Always last."
    }
  }
}
