# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors and local tooling (.claude/launch.json holds machine-specific paths)
.claude/
.vscode/
.idea/
*.log

# the cache in local production builds (on Vercel it lives in Upstash Redis and Vercel Blob)
/.cache

# editions written by /api/edition, and the thread snapshots they were written from
/runs
/snapshots

# prompt dumps from `openui generate`; library.spec.json and schema.json are used and stay checked in
/generated/system-prompt.txt
/generated/system-prompt.spec.json
