root = Edition([headline, map, story, sidebar, colophon])
headline = Headline("Hacker News · Feeds", "A weekend rebuild of YouTube leaves readers asking who the algorithm serves", "Andrej Karpathy’s HackerTube, built in about two hours from Hacker News recommendations, drew 2,668 points and a debate about taste, scale and who should choose what we watch.")
timeline = Query("get_comment_timeline", {id: 50319510}, {comments: []})
map = ThreadMap(timeline.comments, [50319793, 50319890, 50320058, 50320460, 50321152, 50322226, 50323730, 50325518, 50324686, 50320885, 50331429, 50326802, 50324730, 50324775, 50326093, 50327005, 50332290, 50333322, 50336006])
story = Story([art, lede, built, shipped, algorithm, name, ownFeed])
art = LeadArt("/art/hackertube-home.jpg", "HackerTube’s home page shows only videos that Hacker News commenters have recommended, each with a thumbnail taken from the middle of the video.", "Screenshot of hackertube.org")
lede = Lede("On a Friday night in late October, Andrej Karpathy went looking for something to watch on YouTube and found what he called a wall of slop. By Saturday he had built an alternative: HackerTube, a pared-down copy of the site that shows only the 6,454 videos Hacker News commenters have recommended since 2007. It took about two hours, he wrote, and he did not write the code himself. Claude did.")

built = Section("Two hours, two models", [nutGraf, builtIntro, builtQuote, builtSummary, cost])
nutGraf = Prose("The more than 500 comments that followed were less about the site than about what it implied. If a list assembled by strangers feels better than a recommendation engine refined by one of the world’s largest companies, what is that engine optimizing for, and for whom?")
builtIntro = Prose("The post itself is brief. Karpathy describes the YouTube he found as an enshittified wall of slop, and he is blunt about whom its algorithm serves:", null, [Term("enshittified", "From Cory Doctorow’s “enshittification”: platforms getting worse for users as they squeeze more value out of them.")])
builtQuote = ArticleQuote("I'm sure this algorithm works well for the median person on the internet, but it definitely does not work for me.")
builtSummary = ArticleSummary("The project, in his words", ["Opus downloaded every Hacker News comment and ran Sonnet over them, narrowing them to 40,000 that recommend a YouTube video.", "The result is 6,454 videos recommended between 2007 and 2026, across 150 topics.", "Thumbnails are taken from the middle of each video, not chosen by the uploader.", "There are no accounts; recommendations come from state kept in the reader’s own browser.", "The data can be downloaded, so anyone can hand it to an agent and build a different version.", "His only manual steps were a YouTube API key, a server and a domain name."])
cost = Prose("Readers’ first question was the bill. Karpathy had Claude tally it: {1}, nearly all of it spent having Sonnet label comments. Building and deploying the site took about a million tokens of Opus 5.5, which he described as very small by modern standards.", [Quote(50319793, "504M input tokens (90% cached), 7.6M output tokens")])

shipped = Section("Built in public", [shippedRequests, shippedChangelog])
shippedRequests = Prose("The comment thread quickly became a feature queue. Within the first hour, one reader asked for {1}. About 15 minutes later, Karpathy replied: {2}", [Quote(50319890, "filters for duration and sort by upload date"), Quote(50320058, "added and pushed!")])
shippedChangelog = Prose("Less than two hours after posting, he published a changelog that credits each change to the readers who requested it. One addition sorts videos by when Hacker News last recommended them, so that {1}.", [Quote(50320460, "a 2012 talk that someone linked last month floats to the top")])

algorithm = Section("A rounding error", [algorithmCase, algorithmPushback, algorithmPull])
algorithmCase = Prose("The thread’s longest argument began with a reader trying to explain why personalized feeds feel so flat: they are full of things {1}. Karpathy offered a diagnosis from his own field. Platforms learn from the gradient signal of their largest audiences, he suggested, and so {2}.", [Quote(50321152, "I'm supposedly interested in but I just am not when I see them in that format"), Quote(50322226, "we see a massive deterioration of quality because we are a rounding error")], [Term("gradient signal", "In machine learning, the feedback that tells a model which way to adjust. Here: whose behavior the recommender learns from.")])
algorithmPushback = Prose("The idea met resistance. {1}, one reader replied, arguing that nearly everyone believes the algorithm fails them in particular. Another doubted that most viewers want anything different, and proposed a test: {2}", [Quote(50323730, "I can’t reject this line of thought strongly enough"), Quote(50325518, "If tomorrow, YouTube offered a toggle to all users to completely remove shorts from every feed in the app, what would most people do?")])
algorithmPull = PullQuote(50323730, "Everyone is a rounding error, whether you’re in a knitting community, or you’re a worlds leading expert in deep learning.")

name = Section("The name on the post", [nameIntro, namePositions])
nameIntro = Prose("The post’s 2,668 points prompted a second, more pointed debate: whether the same project, posted by someone without Karpathy’s reputation, would have been noticed at all.")
namePositions = Positions("Would HackerTube have reached the top of Hacker News without Karpathy’s name on it?", [nameSide, earnedSide])
nameSide = Side("Mostly the name", "Critics called it a curated playlist made notable by its author; one found similar work posted a year earlier to little notice.", [Quote(50324686, "the amount of glaze he receives for essentially a curated video playlist sourced off of a pre-configured list is unprecedented"), Quote(50320885, "Only 12 upvotes - I guess his name wasn’t Karpathy."), Quote(50331429, "One of the most upvoted posts of the year is a static scrape with a UI?"), Quote(50326802, "Id agree its a pretty mundane idea and product.")])
earnedSide = Side("Attention earned", "Supporters said a record of good work is a fair reason to pay attention, and that the site addresses a real problem.", [Quote(50324730, "The person behind an action does matter, as harsh as that is to some."), Quote(50324775, "This site is a real contribution to the solution of a swamp you do not seem to have perceived."), Quote(50326093, "A person who has built trust through their work will surely attract praise, respect or at least curious gaze.")])

ownFeed = Section("Feeds of one’s own", [ownFeedTemplate, ownFeedCommons])
ownFeedTemplate = Prose("For some readers, HackerTube mattered less as a destination than as a template. Recommendation engines used to be hard to build, one commenter noted, but {1}. Others had already tried. A reader who built a news feed for a small game-development community wrote that {2}.", [Quote(50327005, "now I believe we can likely build our own according to our own preferences"), Quote(50332290, "something like this can be built now in less than 24 hours")])
ownFeedCommons = Prose("Not everyone welcomed the prospect. If every reader retreats into a feed of their own making, one asked, {1} A reply took a calmer view: {2}", [Quote(50333322, "If we all move towards consuming content this way, who is posting what and where?"), Quote(50336006, "Nothing lost, just the source of the truth moved.")])

sidebar = Sidebar([keyPoints, stillOpen, worthALook])
keyPoints = KeyPoints("What to know", ["HackerTube lists 6,454 videos recommended on Hacker News since 2007. Karpathy says it took about two hours to build.", "He shipped features readers requested in the comments, some within the hour.", "The central dispute: do recommendation algorithms fail discerning viewers, or does everyone believe they are the exception?", "Some readers see a model for personal feeds; others worry about who gets discovered if everyone builds one."])
stillOpen = Section("Unresolved", [questions])
questions = OpenQuestions([Question("What happens to Hacker News once other sites are built on top of it?", 50335000), Question("Will YouTube tolerate sites built on its videos?", 50319962), Question("Who gets discovered when everyone curates their own feed?", 50333322)])
worthALook = Section("Further reading", [reading])
reading = ReadingList([sameIdea, fixingYouTube, theData])
sameIdea = ResourceGroup("Built on the same idea", [Resource("HN YouTLDR", "New uploads from the channels Hacker News keeps recommending, with a one-line answer under each title.", "https://hn.youtldr.com"), Resource("cabin.watch", "The same idea, curated by hand: every video watched end to end.", "https://cabin.watch"), Resource("hn.video", "Videos from the current Hacker News front page.", "https://hn.video"), Resource("HackerBooks", "A version for books, posted the next day.", "https://news.ycombinator.com/item?id=50326821"), Resource("Juice", "A news feed for a game-development community, built in under a day.", "https://juice.onejs.com/")])
fixingYouTube = ResourceGroup("Fixing YouTube itself", [Resource("DeArrow", "Crowdsourced titles and real frames in place of clickbait thumbnails.", "https://dearrow.ajay.app/"), Resource("SponsorBlock", "From the developer of DeArrow.", "https://sponsor.ajay.app"), Resource("SmartTube & NewPipe", "Suggested as ad-free YouTube apps for TV and phone.", null, [50323451])])
theData = ResourceGroup("The data", [Resource("HackerTube data", "The dataset behind the site, for building a version of your own.", "https://hackertube.org/data")])

colophon = Colophon()
